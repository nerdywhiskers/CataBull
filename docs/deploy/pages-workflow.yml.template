# GitHub Pages deploy workflow — template
#
# This file is intentionally NOT located at .github/workflows/pages.yml.
# Pushing to that path requires the `workflow` scope on the GitHub OAuth
# token, which the agent here doesn't have. We keep the source-of-truth
# version in docs/ so a fresh clone has it; activating the workflow is a
# manual three-step you do once when you decide to deploy:
#
#   1. Refresh your gh auth with the workflow scope:
#        gh auth refresh -h github.com -s workflow
#
#   2. Copy this file into place and commit:
#        mkdir -p .github/workflows
#        cp docs/pages-workflow.yml.template .github/workflows/pages.yml
#        git add .github/workflows/pages.yml
#        git commit -m "ci: deploy marketing/ to GitHub Pages"
#        git push
#
#   3. In the repo: Settings → Pages → Source: GitHub Actions
#
# After that, any push to `main` that touches marketing/ auto-deploys to
# https://<user>.github.io/career-bot/ within ~30 seconds.

name: Deploy landing page

on:
  push:
    branches: [main]
    paths:
      - 'marketing/**'
      - '.github/workflows/pages.yml'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

# Avoid stomping over an in-progress deploy with another one — Pages
# rejects concurrent uploads anyway.
concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload marketing/ as Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: marketing

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
